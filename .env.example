NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://aisora:aisora@localhost:5432/aisora
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
# Only for Vercel Telegram webhook; use a separate testing bot token.
# Configure a random 1-256 char [A-Za-z0-9_-] secret in Vercel settings.
TELEGRAM_WEBHOOK_SECRET=
# Vercel sets VERCEL=1 automatically. For local HTTP-only testing only:
# AISORA_RUNTIME=vercel
# Generate once with: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=
UNIVERSITY_ADAPTER=abu-ais
# Enable only after explicit ABU authorization. The project owner reported executive approval on 2026-11-12.
AIS_AUTOMATION_APPROVED=false
AIS_BROWSER_PROFILE_DIR=
AIS_BROWSER_HEADLESS=false
AIS_MIN_REQUEST_INTERVAL_MS=1200
AIS_PAGE_TIMEOUT_MS=300000
AIS_NAVIGATION_TIMEOUT_MS=300000
# Timeout for initial journal course dropdown hydration
AIS_JOURNAL_READY_TIMEOUT_MS=45000
AIS_LOGIN_TIMEOUT_MS=90000
AIS_LOOKBACK_WEEKS=3
AIS_PRIORITY_COURSE_NAMES=Архитектура системы блокчейн
AIS_SENT_MESSAGE_DETAIL_LIMIT=50
# Wait for the selected sent message to replace previous message content
AIS_MESSAGE_DETAIL_TIMEOUT_MS=7000
# Bound per-attachment read only for sent messages; general content downloads keep their own timeout
AIS_MESSAGE_ATTACHMENT_TIMEOUT_MS=15000
AIS_CONTENT_DETAIL_TIMEOUT_MS=120000
# Maximum wait for content dialog body to change (prevents 2-minute stalls)
AIS_DETAIL_CHANGE_TIMEOUT_MS=8000
# Short delay after an already verified weekly AJAX switch
AIS_AJAX_SETTLE_MS=1000
# Opt-in: save limited, locally sanitized DOM fragments for troubleshooting
# Local Playwright inspection for performance analysis (OFF by default).
# Starts tracing after login. trace.zip includes private AIS page snapshots.
# Artifacts stay on Mac in git-ignored artifacts/sync-diagnostics/.
AIS_SYNC_DIAGNOSTICS_ENABLED=false
# Set false for fast timing-only reports: skips huge trace.zip snapshots.
AIS_SYNC_TRACE_ENABLED=true
# Experimental: use a short settle only when journal heading confirms the week.
# Keep false until a manual AIS check confirms all assignments are retained.
AIS_ADAPTIVE_WEEK_WAIT=false
AIS_AJAX_FAST_SETTLE_MS=350
AIS_SAVE_DIAGNOSTIC_HTML=false
AIS_HTML_DIAGNOSTICS_DIR=artifacts/ais-html
AIS_SRO_HISTORY_TIMEOUT_MS=10000
AIS_SRO_HISTORY_SETTLE_MS=600
AIS_AGENT_MODEL_ENABLED=false
AIS_AGENT_MODEL_URL=http://127.0.0.1:11434/api/chat
AIS_AGENT_MODEL=qwen2.5:3b-instruct
AIS_AGENT_MODEL_TIMEOUT_MS=45000
AIS_AGENT_REMOTE_DATA_APPROVED=false
AIS_DOWNLOAD_TIMEOUT_MS=120000
AIS_MAX_ATTACHMENT_BYTES=15728640
AIS_MAX_EXTRACTED_TEXT_CHARS=100000
AUTONOMOUS_CHECK_DELAY_MINUTES=5
TZ=Asia/Almaty
